{
  "project": "django-app",
  "platform": "django",
  "environments": {
    "production": {
      "attach_stacktrace": true,
      "max_breadcrumbs": 30,
      "sample_rate": 1.0,
      "traces_sample_rate": 0.1,
      "profile_session_sample_rate": 0.1,
      "enable_logs": true,
      "integrations": {
        "django.DjangoIntegration": {
          "transaction_style": "url"
        }
      },
      "profile_lifecycle": "trace",
      "release": "1.4.2"
    },
    "staging": {
      "attach_stacktrace": true,
      "max_breadcrumbs": 30,
      "sample_rate": 1.0,
      "traces_sample_rate": 0.5,
      "debug": true,
      "enable_logs": true,
      "integrations": {
        "django.DjangoIntegration": {
          "transaction_style": "url"
        }
      },
      "release": "1.4.2"
    }
  }
}
