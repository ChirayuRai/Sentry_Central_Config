{
  "project": "api",
  "platform": "python",
  "environments": {
    "production": {
      "attach_stacktrace": true,
      "max_breadcrumbs": 20,
      "sample_rate": 1.0,
      "traces_sample_rate": 0.1,
      "profile_session_sample_rate": 0.1,
      "ignore_errors": [
        "KeyboardInterrupt",
        "ConnectionResetError"
      ],
      "include_local_variables": false,
      "trace_propagation_targets": [
        "^https://api\\.example\\.com"
      ],
      "integrations": {
        "logging.LoggingIntegration": {
          "level": 20,
          "event_level": 40
        },
        "dedupe.DedupeIntegration": false
      },
      "profile_lifecycle": "trace",
      "release": "1.4.2"
    },
    "staging": {
      "attach_stacktrace": true,
      "max_breadcrumbs": 20,
      "sample_rate": 1.0,
      "traces_sample_rate": 0.5,
      "debug": true,
      "ignore_errors": [
        "KeyboardInterrupt",
        "ConnectionResetError"
      ],
      "include_local_variables": false,
      "trace_propagation_targets": [
        "^https://api\\.example\\.com"
      ],
      "integrations": {
        "logging.LoggingIntegration": {
          "level": 20,
          "event_level": 40
        },
        "dedupe.DedupeIntegration": false
      },
      "release": "1.4.2"
    }
  }
}
