{
  "project": "web-new",
  "platform": "javascript-browser",
  "environments": {
    "production": {
      "attachStacktrace": true,
      "maxBreadcrumbs": 50,
      "sampleRate": 1.0,
      "tracesSampleRate": 0.1,
      "profileSessionSampleRate": 0,
      "replaysSessionSampleRate": 0.05,
      "replaysOnErrorSampleRate": 1.0,
      "transportOptions": {
        "bufferSize": 30
      },
      "ignoreErrors": [
        "ResizeObserver loop limit exceeded",
        {
          "regex": "^Script error\\.?$"
        }
      ],
      "denyUrls": [
        {
          "regex": "^(chrome|moz)-extension://"
        }
      ],
      "tracePropagationTargets": [
        {
          "regex": "^https://api\\.example\\.com"
        }
      ],
      "integrations": {
        "browserTracing": {},
        "replay": {
          "maskAllText": true,
          "blockAllMedia": true
        }
      },
      "release": "1.4.2"
    },
    "staging": {
      "attachStacktrace": true,
      "maxBreadcrumbs": 50,
      "sampleRate": 1.0,
      "tracesSampleRate": 1.0,
      "debug": true,
      "profileSessionSampleRate": 0,
      "transportOptions": {
        "bufferSize": 30
      },
      "ignoreErrors": [
        "ResizeObserver loop limit exceeded",
        {
          "regex": "^Script error\\.?$"
        }
      ],
      "denyUrls": [
        {
          "regex": "^(chrome|moz)-extension://"
        }
      ],
      "tracePropagationTargets": [
        {
          "regex": "^https://api\\.example\\.com"
        }
      ],
      "integrations": {
        "browserTracing": {},
        "replay": {
          "maskAllText": true,
          "blockAllMedia": true
        }
      },
      "release": "1.4.2"
    }
  }
}
